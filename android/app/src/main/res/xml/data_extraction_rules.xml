<?xml version="1.0" encoding="utf-8"?>
<!-- То же для Android 12+: модели распознавания в облачную копию и при переносе на новый телефон не попадают. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="model" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="model" />
    </device-transfer>
</data-extraction-rules>
