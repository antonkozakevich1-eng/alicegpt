<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App.Light" parent="android:Theme.Material.Light.NoActionBar">
        <item name="appBg">@color/light_bg</item>
        <item name="textMain">@color/light_text</item>
        <item name="textDim">@color/light_dim</item>
        <item name="textSubtle">@color/light_subtle</item>
        <item name="hlBg">@color/light_hl_bg</item>
        <item name="hlText">@color/light_hl_text</item>
        <item name="markerColor">@color/light_marker</item>
        <item name="headingColor">@color/light_heading</item>
        <item name="panelBg">@color/light_panel</item>
        <item name="accentColor">@color/light_accent</item>
        <item name="onAccent">@color/light_on_accent</item>
        <item name="android:windowBackground">@color/light_bg</item>
        <item name="android:statusBarColor">@color/light_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/light_text</item>
        <item name="android:colorAccent">@color/light_accent</item>
    </style>

    <style name="Theme.App.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="appBg">@color/dark_bg</item>
        <item name="textMain">@color/dark_text</item>
        <item name="textDim">@color/dark_dim</item>
        <item name="textSubtle">@color/dark_subtle</item>
        <item name="hlBg">@color/dark_hl_bg</item>
        <item name="hlText">@color/dark_hl_text</item>
        <item name="markerColor">@color/dark_marker</item>
        <item name="headingColor">@color/dark_heading</item>
        <item name="panelBg">@color/dark_panel</item>
        <item name="accentColor">@color/dark_accent</item>
        <item name="onAccent">@color/dark_on_accent</item>
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:statusBarColor">@color/dark_bg</item>
        <item name="android:textColorPrimary">@color/dark_text</item>
        <item name="android:colorAccent">@color/dark_accent</item>
    </style>

    <style name="Btn" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_btn</item>
        <item name="android:textColor">?attr/textMain</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="BtnPrimary" parent="Btn">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">?attr/onAccent</item>
        <item name="android:textSize">17sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
