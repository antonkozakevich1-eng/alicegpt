<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App.Light" parent="android:Theme.Material.Light.NoActionBar">
        <item name="appBg">@color/light_bg</item>
        <item name="textMain">@color/light_text</item>
        <item name="textDim">@color/light_dim</item>
        <item name="textSubtle">@color/light_subtle</item>
        <item name="hlBg">@color/light_hl_bg</item>
        <item name="hlText">@color/light_hl_text</item>
        <item name="markerColor">@color/light_marker</item>
        <item name="headingColor">@color/light_heading</item>
        <item name="panelBg">@color/light_panel</item>
        <item name="accentColor">@color/light_accent</item>
        <item name="onAccent">@color/light_on_accent</item>
        <item name="strokeColor">@color/light_stroke</item>
        <item name="goodColor">@color/light_good</item>
        <item name="warnColor">@color/light_warn</item>
        <item name="badColor">@color/light_bad</item>
        <item name="android:windowBackground">@color/light_bg</item>
        <item name="android:statusBarColor">@color/light_bg</item>
        <item name="android:colorBackground">@color/light_bg</item>
        <item name="android:textColorPrimary">@color/light_text</item>
        <item name="android:colorAccent">@color/light_accent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

